---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

/**
 * The ledger. Certificates and badges only, and nothing else in the site
 * shows these documents, so a credential appears exactly once.
 *
 * Each row is a native <details>, so it opens with no JavaScript at all.
 */
const all = await getCollection('credentials');
const rows = [...all].sort((a, b) => b.data.sortKey.localeCompare(a.data.sortKey));

const badgeIds = [
  'aws-cloud-practitioner',
  'aws-academy-cloud-architecting',
  'aws-academy-cloud-foundations',
];
const badges = badgeIds
  .map((id) => rows.find((r) => r.id === id))
  .filter((r): r is (typeof rows)[number] => Boolean(r));
const ledgerRows = rows.filter((r) => !badgeIds.includes(r.id));
---

<section class="movement" id="credentials" aria-labelledby="credentials-title">
  <div class="shell">
    <div class="movement-head">
      <p class="movement-index">04</p>
      <h2 class="movement-title" id="credentials-title">Proof, with the issuer named</h2>
      <p class="movement-lede">
        What I hold, who issued it, and when. Open a row to see the document.
      </p>
    </div>

    <ul class="badges" role="list">
      {
        badges.map((b) => (
          /* A badge is a tile, not a row, but it still owns its anchor: the
             CloudMandap event links to #cred-aws-cloud-practitioner, and the
             AWS tile links here for its three certificates. tabindex="-1" so
             a hash navigation can land focus on it - it is a destination, not
             something anyone tabs through. */
          <li class="badge" id={`cred-${b.id}`} tabindex="-1">
            <Image
              src={b.data.image!}
              alt={b.data.imageAlt ?? b.data.name}
              width={208}
              height={208}
              loading="lazy"
              decoding="async"
              quality={82}
            />
            <span class="badge__name">{b.data.name}</span>
            <span class="ledger__kind">{b.data.kind}</span>
          </li>
        ))
      }
    </ul>

    <div class="ledger">
      {
        /* ledgerRows, not rows: the three AWS badges are already shown above,
           so rendering them here too would put the same credential on the page
           twice and give it two competing anchors. */
        ledgerRows.map((row) => (
          <details class="ledger__row" id={`cred-${row.id}`}>
            <summary>
              <span class="ledger__name">{row.data.name}</span>
              <span class="ledger__date">{row.data.dateLabel}</span>
              <span class="ledger__issuer">
                {row.data.issuer} <span aria-hidden="true">|</span> {row.data.kind}
              </span>
            </summary>
            <div class="ledger__detail">
              {row.data.image && (
                <div class="ledger__doc">
                  <Image
                    src={row.data.image}
                    alt={row.data.imageAlt ?? row.data.name}
                    widths={[400, 700, 1000]}
                    sizes="(min-width: 48rem) 22rem, 92vw"
                    loading="lazy"
                    decoding="async"
                    quality={80}
                  />
                </div>
              )}
              <div class="ledger__body">
                <p class="ledger__kind">{row.data.issuer}</p>
                <p>{row.data.detail}</p>
                <div class="ledger__links">
                  {row.data.verification && (
                    <a href={row.data.verification} target="_blank" rel="noopener noreferrer">
                      Verify this credential
                    </a>
                  )}
                  {row.data.document && (
                    <a href={row.data.document} target="_blank" rel="noopener noreferrer">
                      Open the PDF
                    </a>
                  )}
                </div>
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>