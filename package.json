{
  "name": "nishchal-panta-portfolio",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check:scripts && astro check && astro build && npm run verify:logos && npm run verify:anchors && npm run verify:album",
    "check:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "verify:logos": "node tools/verify-logos.mjs",
    "verify:anchors": "node tools/verify-anchors.mjs",
    "verify:album": "node tools/verify-album.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "photos": "node tools/photo-curator/server.mjs",
    "csp:hash": "node tools/csp-hash.mjs",
    "sync:vars": "node tools/sync-vars.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.0.0",
    "astro": "^5.6.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3"
  }
}
