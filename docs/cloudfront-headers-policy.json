# CloudFront response headers policy for this site.
#
# CHECKED AGAINST WHAT THE PAGE ACTUALLY LOADS:
#   - script-src  'self' + one hash : the theme bootstrap is a small INLINE
#     script in <head>, because it has to run before first paint to stop the
#     flash of the wrong theme. That is allowed only by an exact hash, never by
#     'unsafe-inline'. Run `npm run csp:hash` after editing it and paste the
#     value here; CI fails the build if it has drifted.
#   - style-src   'self'  : Astro emits one external stylesheet. Safe.
#   - font-src    'self'  : the eight self-hosted woff2 subsets. No Google Fonts.
#   - img-src     'self' data: : all imagery is local or a data: URL.
#   - connect-src 'self' + the API origin : the contact form POSTs to an API
#     Gateway URL, which is a DIFFERENT origin from this site, so 'self' alone
#     blocks the fetch in the browser and the form reports "Could not reach the
#     server". The origin is the invokeURL from config.js, scheme + host only,
#     no path. Keep it in step with config.js.

{
  "ResponseHeadersPolicyConfig": {
    "Name": "nishchalpanta-site-headers",
    "SecurityHeadersConfig": {
      "ContentSecurityPolicy": {
        "ContentSecurityPolicy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-7wdG+1KZFWWXx8KCREC7MsoYgRY3b0j8oORLPxXWjAI='; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://ue0l82ocg4.execute-api.us-east-1.amazonaws.com; upgrade-insecure-requests",
        "ContentTypeOptions": {
          "Override": true
        },
        "FrameOptions": {
          "FrameOption": "DENY",
          "Override": true
        },
        "ReferrerPolicy": {
          "ReferrerPolicy": "strict-origin-when-cross-origin",
          "Override": true
        },
        "StrictTransportSecurity": {
          "AccessControlMaxAgeSec": 63072000,
          "IncludeSubdomains": true,
          "Preload": true,
          "Override": true
        }
      }
    },
    "CustomHeadersConfig": {
      "Quantity": 1,
      "Items": [
        {
          "HeaderName": "Permissions-Policy",
          "HeaderValue": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  }
}